# Nix testing / temporary build results
result/

# Host secret keys
age/

*.crt
nix.conf*
nix.custom.conf*
registry.json
*.log

# Machine-local runtime env overrides, sourced at shell startup. Never commit.
.env

# VM disk images. `run-<host>-vm` writes one into the working directory, and `nxm rebuild` stages
# whatever is untracked -- so an unignored image gets committed and pushed.
*.qcow2

# Python bytecode, written whenever lib/scripts/test_nxm.py imports nxm. `nxm rebuild` stages whatever is
# untracked, so an unignored cache gets committed.
__pycache__/
